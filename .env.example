# =============================================================================
# loginrek — env untuk SERVER (VPS) dipakai oleh docker-compose.yml
#
# File ini dikirim ke VPS oleh GitHub Actions. Saat deploy pertama:
#   cd /opt/loginrek && cp .env.example .env && nano .env
# lalu isi semua nilai bertanda CHANGE_ME. File .env di VPS TIDAK pernah
# ditimpa oleh deploy (kecuali baris IMAGE_TAG & GHCR_OWNER yang diperbarui
# otomatis).
#
# Generate APP_KEY:   openssl rand -base64 32
# Generate password:  openssl rand -hex 24
# =============================================================================

# ---- Image (diisi/diperbarui otomatis oleh workflow deploy) -----------------
# Owner GitHub dalam huruf kecil (user/organisasi pemilik repo)
GHCR_OWNER=change-me
IMAGE_TAG=latest

# ---- Port host (bind 127.0.0.1, diteruskan oleh Nginx) ----------------------
# Pilih port yang belum dipakai project lain di VPS.
DASHBOARD_HOST_PORT=3050
POSTGRES_HOST_PORT=5434
RUSTFS_API_HOST_PORT=9100
RUSTFS_CONSOLE_HOST_PORT=9101

# ---- App ---------------------------------------------------------------------
TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
APP_NAME=loginrek
APP_KEY=CHANGE_ME
APP_URL=https://loginrek.example.com
SESSION_DRIVER=cookie
# Origin browser lain yang boleh akses API (pisahkan koma). Mobile app tidak butuh CORS.
CORS_ORIGINS=

# ---- PostgreSQL ----------------------------------------------------------------
# DB_HOST & DB_PORT di-override compose ke service "postgres".
DB_HOST=postgres
DB_PORT=5432
DB_USER=loginrek
DB_PASSWORD=CHANGE_ME
DB_DATABASE=loginrek

# ---- RustFS (object storage) -------------------------------------------------
# S3_ACCESS_KEY / S3_SECRET_KEY juga menjadi kredensial root RustFS.
# S3_ENDPOINT di-override compose ke http://rustfs:9000.
# S3_PUBLIC_ENDPOINT = domain publik RustFS (via Nginx) untuk signed URL foto.
DRIVE_DISK=rustfs
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=https://storage.loginrek.example.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
S3_BUCKET=loginrek
