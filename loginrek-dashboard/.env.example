# =============================================================================
# loginrek-dashboard — env untuk DEVELOPMENT LOKAL
# Salin ke .env lalu jalankan `node ace generate:key`.
# Postgres & RustFS lokal dijalankan dari root: `docker compose up -d postgres rustfs`
# Env produksi ada di /.env.example (root repo) dan dikirim ke VPS.
# =============================================================================

# Node
TZ=UTC
PORT=3333
# 0.0.0.0 agar API bisa diakses HP (Expo Go) di Wi-Fi yang sama
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# App
APP_NAME=loginrek
APP_KEY=
APP_URL=http://localhost:${PORT}

# Session
SESSION_DRIVER=cookie

# CORS (hanya dipakai di production)
CORS_ORIGINS=

# Database (PostgreSQL dari docker compose root)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=loginrek
DB_PASSWORD=loginrek
DB_DATABASE=loginrek

# Object storage (RustFS dari docker compose root)
DRIVE_DISK=rustfs
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=loginrek
S3_SECRET_KEY=loginrek-secret
S3_REGION=us-east-1
S3_BUCKET=loginrek