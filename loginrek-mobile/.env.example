# =============================================================================
# loginrek-mobile — env lokal (opsional). Salin ke .env.local bila perlu.
# Hanya variabel berawalan EXPO_PUBLIC_ yang masuk ke bundle aplikasi —
# JANGAN taruh secret di sini.
# =============================================================================

# Kosongkan untuk deteksi otomatis: app memakai IP laptop yang menjalankan
# `npm run dev` (Metro) + port 3333. Isi bila pakai tunnel / server lain, mis.
#   EXPO_PUBLIC_API_URL=https://xxxx.trycloudflare.com/api/v1
EXPO_PUBLIC_API_URL=

# Port API dashboard di laptop (dipakai saat deteksi otomatis)
EXPO_PUBLIC_API_PORT=3333
